{
  "name": "site-visit-log",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/cds-common-content": "^3.2.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --open site-visits/webapp/index.html",
    "watch:login": "cds watch --profile login --open site-visits/webapp/index.html",
    "test": "node --test test/*.test.js"
  },
  "private": true,
  "description": "Site Visit Log — CAP OData V4 service with Fiori Elements UI (SAPSA Focus Group demo)",
  "cds": {
    "requires": {
      "[development]": {
        "auth": "dummy"
      },
      "[login]": {
        "auth": "mocked"
      }
    }
  }
}
